# Copy to .env and fill in secrets (DO NOT commit .env)

# Database (if using Supabase Postgres or Render Postgres)
# Encode special chars in password (e.g. @ -> %40)
DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<project>.supabase.co:5432/postgres

# Supabase storage (server key is required for bucket creation)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_service_role_...   # use service_role for server operations
UPLOAD_BUCKET=resumes

# App settings
JWT_SECRET=replace-with-long-random-secret
FLASK_ENV=development
FLASK_DEBUG=1
USE_LOCAL_STORAGE=false
PORT=5000
